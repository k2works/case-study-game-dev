<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PuyoPuyoMAUI.MainPage"
             Title="ぷよぷよ TDD">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- タイトル -->
        <Label Grid.Row="0"
               Text="ぷよぷよ TDD"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>

        <!-- ゲーム画面 -->
        <Border Grid.Row="1"
                Stroke="Gray"
                StrokeThickness="2"
                Background="Black"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <GraphicsView x:Name="gameView"
                          WidthRequest="212"
                          HeightRequest="436"/>
        </Border>

        <!-- コントロールボタン -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              Margin="0,20,0,0">

            <Button Grid.Column="0"
                    Text="← 左"
                    Clicked="OnLeftButtonClicked"
                    HorizontalOptions="Fill"/>

            <Button Grid.Column="1"
                    Text="回転"
                    Clicked="OnRotateButtonClicked"
                    HorizontalOptions="Fill"/>

            <Button Grid.Column="2"
                    Text="右 →"
                    Clicked="OnRightButtonClicked"
                    HorizontalOptions="Fill"/>
        </Grid>

    </Grid>

</ContentPage>
