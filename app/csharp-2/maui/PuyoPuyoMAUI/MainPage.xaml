<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PuyoPuyoMAUI.MainPage"
             Title="ぷよぷよ TDD">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- スコア表示 -->
        <Label Grid.Row="0"
               x:Name="scoreLabel"
               Text="Score: 0"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>

        <!-- ゲームオーバー表示 -->
        <Label Grid.Row="1"
               x:Name="gameOverLabel"
               Text="GAME OVER"
               FontSize="32"
               FontAttributes="Bold"
               TextColor="Red"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False"
               ZIndex="10"/>

        <!-- リスタートボタン（ゲームオーバー時のみ表示）-->
        <Button Grid.Row="1"
                x:Name="restartButton"
                Text="リスタート"
                Clicked="OnRestartButtonClicked"
                WidthRequest="200"
                HeightRequest="50"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,100,0,0"
                IsVisible="False"
                ZIndex="10"/>

        <!-- ゲーム画面 -->
        <Border Grid.Row="1"
                Stroke="Gray"
                StrokeThickness="2"
                Background="Black"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <GraphicsView x:Name="gameView"
                          WidthRequest="212"
                          HeightRequest="436"/>
        </Border>

        <!-- コントロールボタン -->
        <HorizontalStackLayout Grid.Row="2"
                               Spacing="20"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,20,0,0">

            <Button Text="← 左"
                    Clicked="OnLeftButtonClicked"
                    WidthRequest="100"
                    HeightRequest="50"/>

            <VerticalStackLayout Spacing="10">
                <Button Text="回転"
                        Clicked="OnRotateButtonClicked"
                        WidthRequest="100"
                        HeightRequest="50"/>
                <Button Text="↓ 下"
                        Clicked="OnDownButtonClicked"
                        Pressed="OnDownButtonPressed"
                        Released="OnDownButtonReleased"
                        WidthRequest="100"
                        HeightRequest="50"/>
            </VerticalStackLayout>

            <Button Text="右 →"
                    Clicked="OnRightButtonClicked"
                    WidthRequest="100"
                    HeightRequest="50"/>

        </HorizontalStackLayout>

    </Grid>

</ContentPage>
