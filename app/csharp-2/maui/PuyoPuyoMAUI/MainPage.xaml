<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PuyoPuyoMAUI.MainPage"
             Title="ぷよぷよ TDD">

    <Grid RowDefinitions="*,Auto" Padding="20">

        <!-- ゲーム画面 -->
        <Border Grid.Row="0"
                Stroke="Gray"
                StrokeThickness="2"
                Background="Black"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <GraphicsView x:Name="gameView"
                          WidthRequest="212"
                          HeightRequest="436"/>
        </Border>

        <!-- コントロールボタン -->
        <HorizontalStackLayout Grid.Row="1"
                               Spacing="20"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,20,0,0">

            <Button Text="← 左"
                    Clicked="OnLeftButtonClicked"
                    WidthRequest="100"
                    HeightRequest="50"/>

            <VerticalStackLayout Spacing="10">
                <Button Text="回転"
                        Clicked="OnRotateButtonClicked"
                        WidthRequest="100"
                        HeightRequest="50"/>
                <Button Text="↓ 下"
                        Clicked="OnDownButtonClicked"
                        Pressed="OnDownButtonPressed"
                        Released="OnDownButtonReleased"
                        WidthRequest="100"
                        HeightRequest="50"/>
            </VerticalStackLayout>

            <Button Text="右 →"
                    Clicked="OnRightButtonClicked"
                    WidthRequest="100"
                    HeightRequest="50"/>

        </HorizontalStackLayout>

    </Grid>

</ContentPage>
