<Project>
  <PropertyGroup>
    <!-- Android SDK の場所を設定 -->
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <!-- Android SDK ライセンスを自動的に受け入れる（開発環境のみ） -->
    <AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
  </PropertyGroup>
</Project>
